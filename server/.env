# WeChat Official Account
WECHAT_TOKEN=your_callback_token
WECHAT_APPID=
WECHAT_SECRET=

# Auth tokens for phone clients (comma separated)
CLIENT_TOKENS=dev-token-123

# Auth tokens for local agent connectors (format deviceId:token, comma separated)
AGENT_TOKENS=my-pc:agent-token-456

# Default local agent device for /code tasks
DEFAULT_AGENT=my-pc

PORT=8080
